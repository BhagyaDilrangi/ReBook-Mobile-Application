<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="32dp"
        android:elevation="4dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register Now"
            android:textColor="#212529"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:layout_gravity="center"/>
        <TextView
            android:id="@+id/txtfirstname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="First Name"
            android:textColor="#495057"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/edit_regi_firstname"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="First Name"
            android:textSize="15sp"
            android:paddingHorizontal="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txtlastname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last Name"
            android:textColor="#495057"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/edit_regi_lastname"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Last Name"
            android:textSize="15sp"
            android:paddingHorizontal="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txttele"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telephone Number"
            android:textColor="#495057"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/edit_regi_tele"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Telephone number"
            android:textSize="15sp"
            android:paddingHorizontal="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txt_regi_passward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Passward"
            android:textColor="#495057"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/edit_regi_passward"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Passward"
            android:textSize="15sp"
            android:paddingHorizontal="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txt_regi_conformedpassward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conformed Passward"
            android:textColor="#495057"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/edit_regi_conformedpassward"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Conformed passward"
            android:textSize="15sp"
            android:paddingHorizontal="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cb_remember_me"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Also Want to Sell"
            android:textColor="#495057"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_gravity="start"
            android:checked="false" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

        </RelativeLayout>

        <Button
            android:id="@+id/regi_btnregister"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Register"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#3B82F6"
            android:layout_marginBottom="16dp"/>



    </LinearLayout>

    </LinearLayout>

</ScrollView>