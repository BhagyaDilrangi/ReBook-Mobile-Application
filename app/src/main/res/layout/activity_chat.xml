<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat" android:layout_width="match_parent"
        android:layout_height="match_parent" android:layout_above="@id/llInput"/>
    <LinearLayout android:id="@+id/llInput" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_alignParentBottom="true"
        android:orientation="horizontal">
        <EditText android:id="@+id/edtMessage" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/btnSend" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Send" />
    </LinearLayout>
</RelativeLayout>