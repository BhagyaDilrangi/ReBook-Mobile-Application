<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F2FF">

    <!-- Chat Header -->
    <LinearLayout
        android:id="@+id/llChatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#E8F2FF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Support Chat"
            android:textSize="24sp"
            android:textColor="#1A237E"
            android:fontFamily="sans-serif-black"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Summary Subheader Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#2196F3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bubbly_fab_bg"
                    android:padding="6dp"
                    android:src="@drawable/ic_inventory"
                    app:tint="#1A237E"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Live Assistance"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#757575" />

                    <TextView
                        android:id="@+id/txtChatSubHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chat with admin or book owners"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#1A237E" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llChatHeader"
        android:layout_above="@id/llInput"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        android:scrollbars="none" />

    <!-- Professional Message Input Bar Container -->
    <LinearLayout
        android:id="@+id/llInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:elevation="8dp">

        <EditText
            android:id="@+id/edtMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input_bg"
            android:hint="Type your message..."
            android:textSize="14sp"
            android:textColor="#1A237E"
            android:textColorHint="#757575"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:maxLines="4"
            android:inputType="textLongMessage|textCapSentences"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Send"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            android:backgroundTint="#2196F3"
            android:paddingHorizontal="20dp"
            app:cornerRadius="24dp" />

    </LinearLayout>

</RelativeLayout>