<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F2FF"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Material"
            android:textSize="24sp"
            android:textColor="#1A237E"
            android:fontFamily="sans-serif-black"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <!-- Form Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#2196F3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Title Input -->
                <EditText
                    android:id="@+id/etEditMaterialTitle"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Material title"
                    android:textColorHint="#1A237E"
                    android:textColor="#1A237E"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="20dp"
                    android:background="@drawable/rounded_input_bg"
                    android:layout_marginBottom="16dp" />

                <!-- Spinner -->
                <Spinner
                    android:id="@+id/spinnerEditMaterialType"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/rounded_input_bg"
                    android:layout_marginBottom="16dp" />

                <!-- Price Input -->
                <EditText
                    android:id="@+id/etEditMaterialPrice"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Price (LKR)"
                    android:textColorHint="#1A237E"
                    android:textColor="#1A237E"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="20dp"
                    android:inputType="numberDecimal"
                    android:background="@drawable/rounded_input_bg" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Update Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateListing"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="UPDATE LISTING"
            android:textSize="15sp"
            android:fontFamily="sans-serif-black"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2196F3"
            app:cornerRadius="30dp"
            android:elevation="4dp" />

    </LinearLayout>
</ScrollView>