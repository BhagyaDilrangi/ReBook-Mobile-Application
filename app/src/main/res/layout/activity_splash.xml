<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1340"
    android:gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Center Row with Logo Card -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Left Small Badge -->
            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="#FFFFFF"
                android:layout_marginEnd="16dp" />

            <!-- App Logo Card Container -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLogo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:cardBackgroundColor="#F0F4FF"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">

                <!-- Splash screen uses ic_book_stack from drawable -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="22dp"
                    android:src="@drawable/ic_book_stack"
                    android:scaleType="centerInside" />
            </androidx.cardview.widget.CardView>

            <!-- Right Small Badge -->
            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="#FFFFFF"
                android:layout_marginStart="16dp" />

        </LinearLayout>

        <!-- App Name -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Rebook"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Typewriter Slogan -->
        <TextView
            android:id="@+id/txtTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>