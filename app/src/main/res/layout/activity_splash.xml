<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1340"
    android:gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Enlarged App Logo Card Container (Side badges removed) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLogo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="#F0F4FF"
            app:cardCornerRadius="36dp"
            app:cardElevation="0dp">

            <!-- Splash screen uses ic_book_stack from drawable -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="26dp"
                android:src="@drawable/ic_book_stack"
                android:scaleType="centerInside" />
        </androidx.cardview.widget.CardView>

        <!-- Enlarged App Name -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Rebook"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Enlarged Typewriter Slogan -->
        <TextView
            android:id="@+id/txtTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>